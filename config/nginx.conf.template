worker_processes 1;
daemon off;
pid "{{ROOT}}/tmp/nginx.pid";
error_log "{{ROOT}}/logs/nginx_error.log" warn;

events {
    worker_connections 1024;
}

http {
    include "{{ROOT}}/config/mime.types";
    default_type application/octet-stream;

    access_log "{{ROOT}}/logs/nginx_access.log";
    client_body_temp_path "{{ROOT}}/tmp/nginx_client_body";
    proxy_temp_path "{{ROOT}}/tmp/nginx_proxy";
    fastcgi_temp_path "{{ROOT}}/tmp/nginx_fastcgi";
    uwsgi_temp_path "{{ROOT}}/tmp/nginx_uwsgi";
    scgi_temp_path "{{ROOT}}/tmp/nginx_scgi";

    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 65;
    client_max_body_size 64M;

    server {
        listen {{PORT}};
        server_name 127.0.0.1 localhost;
        root "{{APP_DIR}}";
        index index.php index.html;

        location = /favicon.ico {
            log_not_found off;
            access_log off;
        }

        location = /robots.txt {
            allow all;
            log_not_found off;
            access_log off;
        }

        # Deny hidden files
        location ~ /\. {
            deny all;
        }

        # Deny sensitive directories
        location ~ ^/(app|bin|cache|classes|config|controllers|docs|localization|override|src|tests|tools|translations|travis-scripts|vendor)/ {
            deny all;
        }

        # Deny sensitive files
        location ~ \.(yml|yaml|twig|env|tpl|sql|log)$ {
            deny all;
        }

        # PrestaShop URL rewriting for images and api
        rewrite ^/api/?(.*)$ /webservice/dispatcher.php?url=$1 last;
        rewrite ^/([0-9])(-[_a-zA-Z0-9-]*)?(-[0-9]+)?/.+\.jpg$ /img/p/$1/$1$2$3.jpg last;
        rewrite ^/([0-9])([0-9])(-[_a-zA-Z0-9-]*)?(-[0-9]+)?/.+\.jpg$ /img/p/$1/$2/$1$2$3$4.jpg last;
        rewrite ^/([0-9])([0-9])([0-9])(-[_a-zA-Z0-9-]*)?(-[0-9]+)?/.+\.jpg$ /img/p/$1/$2/$3/$1$2$3$4$5.jpg last;
        rewrite ^/([0-9])([0-9])([0-9])([0-9])(-[_a-zA-Z0-9-]*)?(-[0-9]+)?/.+\.jpg$ /img/p/$1/$2/$3/$4/$1$2$3$4$5$6.jpg last;
        rewrite ^/c/([0-9]+)(-[.*_a-zA-Z0-9-]*)(-[0-9]+)?/.+\.jpg$ /img/c/$1$2$3.jpg last;
        rewrite ^/c/([a-zA-Z_-]+)(-[0-9]+)?/.+\.jpg$ /img/c/$1$2.jpg last;

        # Standard PrestaShop routing
        location / {
            try_files $uri $uri/ /index.php$is_args$args;
        }

        # FastCGI pass to PHP-CGI
        location ~ [^/]\.php(/|$) {
            fastcgi_split_path_info ^(.+?\.php)(/.*)$;
            if (!-f $document_root$fastcgi_script_name) {
                return 404;
            }

            fastcgi_index index.php;
            include "{{ROOT}}/config/fastcgi.conf";
            fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
            fastcgi_param PATH_INFO $fastcgi_path_info;
            fastcgi_param HTTP_PROXY "";

            fastcgi_read_timeout 300;
            fastcgi_pass 127.0.0.1:{{PHP_PORT}};
        }
    }
}
