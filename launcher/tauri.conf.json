{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PrestaShop Portable",
  "version": "0.4.0",
  "identifier": "com.prestashop.portable",
  "build": {
    "frontendDist": "ui"
  },
  "bundle": {
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "PrestaShop Portable",
        "label": "main",
        "width": 600,
        "height": 420,
        "minWidth": 600,
        "maxWidth": 600,
        "minHeight": 420,
        "maxHeight": 420,
        "resizable": false,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  }
}
