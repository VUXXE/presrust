{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PrestaShop Portable",
  "version": "0.5.1",
  "identifier": "com.prestashop.portable",
  "build": {
    "frontendDist": "ui"
  },
  "bundle": {
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "PrestaShop Portable",
        "label": "main",
        "width": 620,
        "height": 480,
        "minWidth": 620,
        "maxWidth": 620,
        "minHeight": 480,
        "maxHeight": 480,
        "resizable": false,
        "decorations": true,
        "transparent": false,
        "visible": true,
        "focus": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  }
}
