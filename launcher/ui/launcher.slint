import { Button, CheckBox, LineEdit, ScrollView } from "std-widgets.slint";

export struct LogItem {
    timestamp: string,
    source: string,
    message: string,
}

export component MainWindow inherits Window {
    title: "PrestaShop Portable";
    min-width: 440px;
    max-width: 520px;
    preferred-width: 460px;
    min-height: 290px;
    preferred-height: show-log-drawer ? 580px : (show-settings ? 460px : 320px);
    background: #111216;
    default-font-family: "Inter, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, sans-serif";

    // Properties bound to Rust state
    in-out property <bool> is-running: false;
    in-out property <bool> is-setup-mode: true;
    in-out property <bool> is-busy: false;
    in-out property <string> host-url: "http://127.0.0.1:8080";
    in-out property <string> admin-folder: "";
    in-out property <string> db-host: "127.0.0.1";
    in-out property <string> db-port: "3306";
    in-out property <string> db-user: "root";
    in-out property <string> db-name: "prestashop";
    in-out property <string> db-copy-text: "Salin";
    in-out property <string> status-text: "Berhenti";
    in-out property <string> launcher-version: "v0.4";

    // Log Drawer Properties
    in-out property <bool> show-log-drawer: false;
    in-out property <string> log-filter: "ALL";
    in-out property <bool> auto-scroll: true;
    in-out property <string> log-content: "";
    in-out property <string> copy-log-text: "Salin Log";

    // Settings Modal
    in-out property <bool> show-settings: false;
    in-out property <string> cfg-web-port: "8080";
    in-out property <string> cfg-php-port: "9000";
    in-out property <string> cfg-db-port: "3306";

    // Callbacks to Rust
    callback start-services();
    callback stop-services();
    callback open-shop();
    callback open-admin();
    callback copy-db-info();
    callback copy-logs();
    callback clear-logs();
    callback open-logs-folder();
    callback save-settings(string, string, string);
    callback toggle-log-filter(string);

    VerticalLayout {
        padding: 18px;
        spacing: 14px;

        // 1. Top Header: Title + Status Pill
        HorizontalLayout {
            alignment: space-between;

            VerticalLayout {
                spacing: 2px;
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "PrestaShop";
                        font-size: 18px;
                        font-weight: 700;
                        color: #ffffff;
                    }
                    Rectangle {
                        background: #232630;
                        border-radius: 4px;
                        y: 2px;
                        height: 20px;
                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            Text {
                                text: "Portable";
                                font-size: 11px;
                                font-weight: 600;
                                color: #94a3b8;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                            }
                        }
                    }
                }
            }

            // Status Pill
            Rectangle {
                background: root.is-running ? #064e3b : #1e2026;
                border-radius: 12px;
                border-width: 1px;
                border-color: root.is-running ? #059669 : #333642;
                height: 24px;

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 6px;
                    alignment: center;
                    Rectangle {
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: root.is-running ? #10b981 : #94a3b8;
                        y: 8px;
                    }
                    Text {
                        text: root.is-running ? "Berjalan" : "Berhenti";
                        font-size: 12px;
                        font-weight: 600;
                        color: root.is-running ? #34d399 : #94a3b8;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // 2. Central Active Card (Clean & Compact)
        Rectangle {
            background: #191b22;
            border-radius: 10px;
            border-width: 1px;
            border-color: #272a34;

            VerticalLayout {
                padding: 16px;
                spacing: 12px;

                if root.is-running: VerticalLayout {
                    spacing: 12px;
                    // URL row
                    HorizontalLayout {
                        alignment: space-between;
                        Text {
                            text: "URL Layanan";
                            font-size: 13px;
                            color: #94a3b8;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.host-url;
                            font-size: 14px;
                            font-weight: 600;
                            color: #38bdf8;
                            vertical-alignment: center;
                        }
                    }

                    // Open Action Buttons
                    HorizontalLayout {
                        spacing: 10px;
                        height: 38px;

                        // Primary Web Button
                        Rectangle {
                            background: #2563eb;
                            border-radius: 6px;
                            TouchArea {
                                clicked => { root.open-shop(); }
                            }
                            Text {
                                text: root.is-setup-mode ? "🚀  Buka Setup Toko" : "🛍️  Buka Toko";
                                font-size: 13px;
                                font-weight: 600;
                                color: #ffffff;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        // Admin Button (if setup done)
                        if !root.is-setup-mode && root.admin-folder != "": Rectangle {
                            width: 130px;
                            background: #4f46e5;
                            border-radius: 6px;
                            TouchArea {
                                clicked => { root.open-admin(); }
                            }
                            Text {
                                text: "🔐  Admin";
                                font-size: 13px;
                                font-weight: 600;
                                color: #ffffff;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                if !root.is-running: VerticalLayout {
                    alignment: center;
                    height: 48px;
                    Text {
                        text: "Layanan dalam keadaan nonaktif";
                        font-size: 13px;
                        color: #64748b;
                        horizontal-alignment: center;
                    }
                }
            }
        }

        // 3. Database Info Pill (Setup Mode only - Compact 1-line)
        if root.is-running && root.is-setup-mode: Rectangle {
            background: #172033;
            border-radius: 6px;
            border-width: 1px;
            border-color: #1e3a8a;
            height: 34px;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 8px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;
                    Text {
                        text: "Database: " + root.db-name;
                        font-size: 12px;
                        font-weight: 600;
                        color: #93c5fd;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "User: " + root.db-user;
                        font-size: 12px;
                        color: #cbd5e1;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "Port: " + root.db-port;
                        font-size: 12px;
                        color: #cbd5e1;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    background: #1d4ed8;
                    border-radius: 4px;
                    width: 58px;
                    height: 24px;
                    y: 5px;
                    TouchArea {
                        clicked => { root.copy-db-info(); }
                    }
                    Text {
                        text: root.db-copy-text;
                        font-size: 11px;
                        font-weight: 600;
                        color: #ffffff;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // 4. Main Control Button (Start / Stop)
        Rectangle {
            height: 44px;
            border-radius: 8px;
            background: root.is-running ? #dc2626 : #059669;

            TouchArea {
                enabled: !root.is-busy;
                clicked => {
                    if (root.is-running) {
                        root.stop-services();
                    } else {
                        root.start-services();
                    }
                }
            }

            Text {
                text: root.is-busy ? "Memproses..." : (root.is-running ? "■  Hentikan Layanan" : "▶  Jalankan Layanan");
                font-size: 14px;
                font-weight: 700;
                color: #ffffff;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // 5. Settings Panel (Collapsible)
        if root.show-settings: Rectangle {
            background: #191b22;
            border-radius: 8px;
            border-width: 1px;
            border-color: #333744;

            VerticalLayout {
                padding: 14px;
                spacing: 10px;

                Text {
                    text: "Pengaturan Port";
                    font-size: 13px;
                    font-weight: 700;
                    color: #e2e8f0;
                }

                HorizontalLayout {
                    spacing: 10px;
                    Text { text: "Port Web:"; font-size: 12px; color: #94a3b8; vertical-alignment: center; width: 90px; }
                    web-port-input := LineEdit { text: root.cfg-web-port; }
                }

                HorizontalLayout {
                    spacing: 10px;
                    Text { text: "Port PHP:"; font-size: 12px; color: #94a3b8; vertical-alignment: center; width: 90px; }
                    php-port-input := LineEdit { text: root.cfg-php-port; }
                }

                HorizontalLayout {
                    spacing: 10px;
                    Text { text: "Port MariaDB:"; font-size: 12px; color: #94a3b8; vertical-alignment: center; width: 90px; }
                    db-port-input := LineEdit { text: root.cfg-db-port; }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    Button {
                        text: "Batal";
                        clicked => { root.show-settings = false; }
                    }
                    Button {
                        text: "Simpan";
                        clicked => {
                            root.save-settings(web-port-input.text, php-port-input.text, db-port-input.text);
                            root.show-settings = false;
                        }
                    }
                }
            }
        }

        // 6. Log Drawer Panel (Collapsible)
        if root.show-log-drawer: Rectangle {
            background: #14151a;
            border-radius: 8px;
            border-width: 1px;
            border-color: #272a34;
            height: 220px;

            VerticalLayout {
                padding: 10px;
                spacing: 8px;

                HorizontalLayout {
                    alignment: space-between;
                    HorizontalLayout {
                        spacing: 6px;
                        Button {
                            text: root.log-filter == "ALL" ? "[Semua]" : "Semua";
                            clicked => { root.toggle-log-filter("ALL"); }
                        }
                        Button {
                            text: root.log-filter == "NGINX" ? "[Nginx]" : "Nginx";
                            clicked => { root.toggle-log-filter("NGINX"); }
                        }
                        Button {
                            text: root.log-filter == "PHP" ? "[PHP]" : "PHP";
                            clicked => { root.toggle-log-filter("PHP"); }
                        }
                        Button {
                            text: root.log-filter == "DB" ? "[DB]" : "DB";
                            clicked => { root.toggle-log-filter("DB"); }
                        }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        Button {
                            text: root.copy-log-text;
                            clicked => { root.copy-logs(); }
                        }
                        Button {
                            text: "Bersihkan";
                            clicked => { root.clear-logs(); }
                        }
                    }
                }

                ScrollView {
                    Rectangle {
                        background: #090a0d;
                        border-radius: 4px;
                        min-height: 150px;
                        VerticalLayout {
                            padding: 8px;
                            Text {
                                text: root.log-content != "" ? root.log-content : "Menunggu log aktivitas...";
                                font-size: 11px;
                                font-family: "monospace";
                                color: #cbd5e1;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }
        }

        // 7. Minimal Footer
        HorizontalLayout {
            alignment: space-between;
            HorizontalLayout {
                spacing: 12px;
                Rectangle {
                    background: transparent;
                    TouchArea {
                        clicked => { root.show-settings = !root.show-settings; }
                    }
                    Text {
                        text: root.show-settings ? "Tutup Pengaturan" : "⚙ Pengaturan";
                        font-size: 12px;
                        color: #94a3b8;
                    }
                }
                if root.show-log-drawer: Rectangle {
                    background: transparent;
                    TouchArea {
                        clicked => { root.open-logs-folder(); }
                    }
                    Text {
                        text: "📁 Folder Log";
                        font-size: 12px;
                        color: #94a3b8;
                    }
                }
            }

            HorizontalLayout {
                spacing: 12px;
                Rectangle {
                    background: transparent;
                    TouchArea {
                        clicked => { root.show-log-drawer = !root.show-log-drawer; }
                    }
                    Text {
                        text: root.show-log-drawer ? "▲ Sembunyikan Log" : "▼ Log Aktivitas";
                        font-size: 12px;
                        color: #94a3b8;
                    }
                }
            }
        }
    }
}
