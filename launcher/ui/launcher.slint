import { Button, CheckBox, LineEdit, ScrollView } from "std-widgets.slint";

export struct LogItem {
    timestamp: string,
    source: string,
    message: string,
}

export component MainWindow inherits Window {
    title: "PrestaShop Portable";
    min-width: 480px;
    max-width: 480px;
    min-height: 380px;
    max-height: 380px;
    background: #111216;
    default-font-family: "Inter, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, sans-serif";

    // Tab Index: 0 = Layanan, 1 = Log, 2 = Pengaturan
    property <int> active-tab: 0;

    // Properties bound to Rust state
    in-out property <bool> is-running: false;
    in-out property <bool> is-setup-mode: true;
    in-out property <bool> is-busy: false;
    in-out property <string> host-url: "http://127.0.0.1:8080";
    in-out property <string> admin-folder: "";
    in-out property <string> db-host: "127.0.0.1";
    in-out property <string> db-port: "3306";
    in-out property <string> db-user: "root";
    in-out property <string> db-name: "prestashop";
    in-out property <string> db-copy-text: "Salin";
    in-out property <string> status-text: "Berhenti";
    in-out property <string> launcher-version: "v0.4";

    // Log Drawer Properties (retained for Rust bindings)
    in-out property <bool> show-log-drawer: false;
    in-out property <string> log-filter: "ALL";
    in-out property <bool> auto-scroll: true;
    in-out property <string> log-content: "";
    in-out property <string> copy-log-text: "Salin";

    // Settings Properties (retained for Rust bindings)
    in-out property <bool> show-settings: false;
    in-out property <string> cfg-web-port: "8080";
    in-out property <string> cfg-php-port: "9000";
    in-out property <string> cfg-db-port: "3306";

    // Callbacks to Rust
    callback start-services();
    callback stop-services();
    callback open-shop();
    callback open-admin();
    callback copy-db-info();
    callback copy-logs();
    callback clear-logs();
    callback open-logs-folder();
    callback save-settings(string, string, string);
    callback toggle-log-filter(string);

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        // 1. Top Header: Title + Status Pill
        HorizontalLayout {
            alignment: space-between;

            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: "PrestaShop";
                    font-size: 18px;
                    font-weight: 700;
                    color: #ffffff;
                    vertical-alignment: center;
                }
                Rectangle {
                    background: #232630;
                    border-radius: 4px;
                    y: 4px;
                    height: 18px;
                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        Text {
                            text: "Portable";
                            font-size: 10px;
                            font-weight: 600;
                            color: #94a3b8;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                    }
                }
            }

            // Status Pill
            Rectangle {
                background: root.is-running ? #064e3b : #1e2026;
                border-radius: 12px;
                border-width: 1px;
                border-color: root.is-running ? #059669 : #333642;
                height: 24px;

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 6px;
                    alignment: center;
                    Rectangle {
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: root.is-running ? #10b981 : #94a3b8;
                        y: 8px;
                    }
                    Text {
                        text: root.is-running ? "Berjalan" : "Berhenti";
                        font-size: 12px;
                        font-weight: 600;
                        color: root.is-running ? #34d399 : #94a3b8;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // 2. Navigation Tab Bar (Segmented Control)
        Rectangle {
            background: #191b22;
            border-radius: 7px;
            height: 32px;
            border-width: 1px;
            border-color: #242732;

            HorizontalLayout {
                padding: 2px;
                spacing: 2px;

                // Tab 0: Layanan
                Rectangle {
                    background: root.active-tab == 0 ? #2563eb : transparent;
                    border-radius: 5px;
                    TouchArea {
                        clicked => { root.active-tab = 0; }
                    }
                    Text {
                        text: "⚡  Layanan";
                        font-size: 12px;
                        font-weight: root.active-tab == 0 ? 600 : 500;
                        color: root.active-tab == 0 ? #ffffff : #94a3b8;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                // Tab 1: Log
                Rectangle {
                    background: root.active-tab == 1 ? #2563eb : transparent;
                    border-radius: 5px;
                    TouchArea {
                        clicked => { root.active-tab = 1; }
                    }
                    Text {
                        text: "📜  Log Aktivitas";
                        font-size: 12px;
                        font-weight: root.active-tab == 1 ? 600 : 500;
                        color: root.active-tab == 1 ? #ffffff : #94a3b8;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                // Tab 2: Pengaturan
                Rectangle {
                    background: root.active-tab == 2 ? #2563eb : transparent;
                    border-radius: 5px;
                    TouchArea {
                        clicked => { root.active-tab = 2; }
                    }
                    Text {
                        text: "⚙  Pengaturan";
                        font-size: 12px;
                        font-weight: root.active-tab == 2 ? 600 : 500;
                        color: root.active-tab == 2 ? #ffffff : #94a3b8;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // 3. Tab Contents (Strictly bounded height)

        // Tab 0: Layanan View
        if root.active-tab == 0: VerticalLayout {
            spacing: 10px;

            // Service URL & Action Card
            Rectangle {
                background: #191b22;
                border-radius: 8px;
                border-width: 1px;
                border-color: #272a34;
                height: 104px;

                VerticalLayout {
                    padding: 12px;
                    spacing: 10px;

                    if root.is-running: HorizontalLayout {
                        alignment: space-between;
                        Text {
                            text: "Alamat Web:";
                            font-size: 12px;
                            color: #94a3b8;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.host-url;
                            font-size: 13px;
                            font-weight: 600;
                            color: #38bdf8;
                            vertical-alignment: center;
                        }
                    }

                    if root.is-running: HorizontalLayout {
                        spacing: 8px;
                        height: 36px;

                        Rectangle {
                            background: #2563eb;
                            border-radius: 6px;
                            TouchArea {
                                clicked => { root.open-shop(); }
                            }
                            Text {
                                text: root.is-setup-mode ? "🚀  Buka Setup Toko" : "🛍️  Buka Toko";
                                font-size: 12px;
                                font-weight: 600;
                                color: #ffffff;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        if !root.is-setup-mode && root.admin-folder != "": Rectangle {
                            width: 120px;
                            background: #4f46e5;
                            border-radius: 6px;
                            TouchArea {
                                clicked => { root.open-admin(); }
                            }
                            Text {
                                text: "🔐  Admin";
                                font-size: 12px;
                                font-weight: 600;
                                color: #ffffff;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    if !root.is-running: VerticalLayout {
                        alignment: center;
                        height: 80px;
                        spacing: 4px;
                        Text {
                            text: "Layanan dalam keadaan nonaktif";
                            font-size: 13px;
                            font-weight: 600;
                            color: #cbd5e1;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "Klik tombol di bawah untuk menyalakan Nginx, PHP, dan MariaDB";
                            font-size: 11px;
                            color: #64748b;
                            horizontal-alignment: center;
                        }
                    }
                }
            }

            // DB Info Pill (only when running & in setup mode)
            if root.is-running && root.is-setup-mode: Rectangle {
                background: #172033;
                border-radius: 6px;
                border-width: 1px;
                border-color: #1e3a8a;
                height: 32px;

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 6px;
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 12px;
                        Text {
                            text: "Database: " + root.db-name;
                            font-size: 11px;
                            font-weight: 600;
                            color: #93c5fd;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "User: " + root.db-user;
                            font-size: 11px;
                            color: #cbd5e1;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "Port: " + root.db-port;
                            font-size: 11px;
                            color: #cbd5e1;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        background: #1d4ed8;
                        border-radius: 4px;
                        width: 52px;
                        height: 22px;
                        y: 5px;
                        TouchArea {
                            clicked => { root.copy-db-info(); }
                        }
                        Text {
                            text: root.db-copy-text;
                            font-size: 11px;
                            font-weight: 600;
                            color: #ffffff;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // Main Action Button (Start / Stop)
            Rectangle {
                height: 44px;
                border-radius: 8px;
                background: root.is-running ? #dc2626 : #059669;

                TouchArea {
                    enabled: !root.is-busy;
                    clicked => {
                        if (root.is-running) {
                            root.stop-services();
                        } else {
                            root.start-services();
                        }
                    }
                }

                Text {
                    text: root.is-busy ? "Memproses..." : (root.is-running ? "■  Hentikan Layanan" : "▶  Jalankan Layanan");
                    font-size: 14px;
                    font-weight: 700;
                    color: #ffffff;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        // Tab 1: Log View
        if root.active-tab == 1: VerticalLayout {
            spacing: 8px;

            HorizontalLayout {
                alignment: space-between;
                HorizontalLayout {
                    spacing: 4px;
                    Button {
                        text: root.log-filter == "ALL" ? "[Semua]" : "Semua";
                        clicked => { root.toggle-log-filter("ALL"); }
                    }
                    Button {
                        text: root.log-filter == "NGINX" ? "[Nginx]" : "Nginx";
                        clicked => { root.toggle-log-filter("NGINX"); }
                    }
                    Button {
                        text: root.log-filter == "PHP" ? "[PHP]" : "PHP";
                        clicked => { root.toggle-log-filter("PHP"); }
                    }
                    Button {
                        text: root.log-filter == "DB" ? "[DB]" : "DB";
                        clicked => { root.toggle-log-filter("DB"); }
                    }
                }
                HorizontalLayout {
                    spacing: 4px;
                    Button {
                        text: root.copy-log-text;
                        clicked => { root.copy-logs(); }
                    }
                    Button {
                        text: "Bersihkan";
                        clicked => { root.clear-logs(); }
                    }
                    Button {
                        text: "📁 Folder";
                        clicked => { root.open-logs-folder(); }
                    }
                }
            }

            ScrollView {
                height: 195px;
                Rectangle {
                    background: #090a0d;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: #1f222a;
                    min-height: 195px;
                    VerticalLayout {
                        padding: 8px;
                        Text {
                            text: root.log-content != "" ? root.log-content : "Menunggu log aktivitas...";
                            font-size: 11px;
                            font-family: "monospace";
                            color: #cbd5e1;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }

        // Tab 2: Settings View
        if root.active-tab == 2: VerticalLayout {
            spacing: 10px;

            Rectangle {
                background: #191b22;
                border-radius: 8px;
                border-width: 1px;
                border-color: #272a34;
                height: 232px;

                VerticalLayout {
                    padding: 14px;
                    spacing: 10px;

                    Text {
                        text: "Konfigurasi Port Jaringan";
                        font-size: 13px;
                        font-weight: 700;
                        color: #ffffff;
                    }

                    HorizontalLayout {
                        spacing: 10px;
                        Text { text: "Port Web (Nginx):"; font-size: 12px; color: #94a3b8; vertical-alignment: center; width: 140px; }
                        web-port-input := LineEdit { text: root.cfg-web-port; }
                    }

                    HorizontalLayout {
                        spacing: 10px;
                        Text { text: "Port PHP (FastCGI):"; font-size: 12px; color: #94a3b8; vertical-alignment: center; width: 140px; }
                        php-port-input := LineEdit { text: root.cfg-php-port; }
                    }

                    HorizontalLayout {
                        spacing: 10px;
                        Text { text: "Port Database (MariaDB):"; font-size: 12px; color: #94a3b8; vertical-alignment: center; width: 140px; }
                        db-port-input := LineEdit { text: root.cfg-db-port; }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;
                        Button {
                            text: "Batal";
                            clicked => { root.active-tab = 0; }
                        }
                        Button {
                            text: "Simpan Port";
                            clicked => {
                                root.save-settings(web-port-input.text, php-port-input.text, db-port-input.text);
                                root.active-tab = 0;
                            }
                        }
                    }
                }
            }
        }

        // 4. Subtle Bottom Status
        HorizontalLayout {
            alignment: space-between;
            Text {
                text: "PrestaShop 9.0 • MariaDB 11.4 • PHP 8.4";
                font-size: 11px;
                color: #475569;
                vertical-alignment: center;
            }
            Text {
                text: root.launcher-version;
                font-size: 11px;
                color: #475569;
                vertical-alignment: center;
            }
        }
    }
}
